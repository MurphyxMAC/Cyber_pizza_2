{
  "name": "cyberpizza-v2",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:sql": "node --experimental-strip-types --test supabase/verify-migration.test.mts",
    "db:migrate": "pnpm --filter @cyberpizza/web db:migrate",
    "test:contracts": "forge test --root contracts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "keccak",
      "bufferutil",
      "utf-8-validate",
      "unrs-resolver"
    ],
    "packageExtensions": {
      "@coinbase/cdp-sdk": {
        "dependencies": {
          "@x402/core": "2.28.0",
          "@x402/evm": "2.28.0",
          "@x402/svm": "2.28.0"
        }
      }
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "turbo": "^2.11.8"
  }
}
