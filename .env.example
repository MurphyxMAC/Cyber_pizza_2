# Copy the web block to apps/web/.env.local
# Copy the contract block to contracts/.env
# Never commit either file.

# --- apps/web/.env.local ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/cyberpizza
SESSION_SECRET=replace-with-at-least-32-random-characters
# Server key. Its address must equal PizzaRewards.signer. 0x + 64 hex chars.
SIGNER_PRIVATE_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CPT_TOKEN_ADDRESS=
NEXT_PUBLIC_PIZZA_REWARDS_ADDRESS=
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CLAIM_DEADLINE_SECONDS=3600
# Optional. When both are set, rate limits use Upstash. Otherwise an in-memory window is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- contracts/.env ---
# Deployer key. Foundry reads this from contracts/.env. 0x-prefixed.
PRIVATE_KEY=
# Optional. Defaults to the deployer. Use a separate hot key for the web signer.
SIGNER_ADDRESS=
# Whole CPT the rewards contract may mint per 24h window. Default 10000.
DAILY_MINT_CAP_CPT=10000
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
